                                                                        </ContextMenu.Resources>
                                                                        <MenuItem x:Name="DataGridQueryResultMenuItemCopy" Header="Copy" InputGestureText="Ctrl+C" Template="{StaticResource DataGridQueryResultFlatMenuItem}">
