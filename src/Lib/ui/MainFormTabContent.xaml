                                                        <TextBlock Grid.Column="1" x:Name="ImageOutputStatus" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xF232;" />
                                                        <TextBlock Grid.Column="3" x:Name="TextBlockOutputBox" Text="Results:" />
                                                </Grid>
                                                <TabControl x:Name="TabControlQueryOutput" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <TabItem Header="Results">
                                                <!-- One result grid per statement, stacked (issue #151). Execute used to run the
                                                     editor as a single query bound to a single DataGrid, so two SELECTs could not be
                                                     compared without running each and losing the previous result.

                                                     The outer ScrollViewer is what makes the five-row floor work: each grid's height
                                                     is set in code to Max(equal share, header + five rows), so once there are enough
                                                     results the stack is taller than the viewport and this scrolls. Auto, not
                                                     Visible, so a single result shows no scrollbar at all.

                                                     ItemsSource is assigned in code rather than bound to a view model, matching how
                                                     this application drives the rest of its UI, and because the per-result state
                                                     lives on the tab session - see the QueryMessages precedent in
                                                     Write-TabMessage.ps1.

                                                     The per-result DataGrid is deliberately NOT named: names declared inside a
                                                     DataTemplate do not reach FindName, so a name here would resolve to nothing and
                                                     read as if it should. Consumers reach the focused result through the tab
                                                     session instead. -->
                                                <Grid>
                                                <ScrollViewer x:Name="ScrollViewerQueryResults" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                                                        <ItemsControl x:Name="ItemsControlQueryResults" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Vertical" />
                                                                        </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                                <Grid Margin="0,0,0,6">
                                                                                        <Grid.RowDefinitions>
                                                                                                <!-- All Auto: the item's desired height is the header plus whatever
                                                                                                     height the sizing pass gave the grid, plus the splitter, which is
                                                                                                     what the outer ScrollViewer measures against its viewport. -->
                                                                                                <RowDefinition Height="Auto" />
                                                                                                <RowDefinition Height="Auto" />
                                                                                                <RowDefinition Height="Auto" />
                                                                                        </Grid.RowDefinitions>
                                                                                        <TextBlock Grid.Row="0" Style="{StaticResource QueryResultHeaderStyle}" Text="{Binding Header}" ToolTip="{Binding Header}" />
                                                                                        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" ContextMenu="{StaticResource DataGridQueryResultContextMenu}" AutoGenerateColumns="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" IsReadOnly="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="False" Focusable="True" IsTabStop="True" SelectionMode="Extended" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader">
                                                                                                <DataGrid.Resources>
                                                                                                        <Style TargetType="TextBlock">
                                                                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                                                        </Style>
                                                                                                </DataGrid.Resources>
                                                                                        </DataGrid>
                                                                                        <!-- Drag to resize this result (issue #151 feedback). ResizeBehavior is
                                                                                             CurrentAndNext in a Grid whose rows are Auto, so the splitter cannot
                                                                                             size them itself - Register-QueryResultGridHandler watches
                                                                                             DragCompleted and writes the new height onto the DataGrid instead,
                                                                                             which is also what lets the sizing pass know the user has sized this
                                                                                             one and leave it alone until the next execute. -->
                                                                                        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" ResizeDirection="Rows" ResizeBehavior="CurrentAndNext" ShowsPreview="False" Background="#E5E7EB" Cursor="SizeNS" />
                                                                                </Grid>
                                                                        </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                </ScrollViewer>
                                                <!-- Results to Text: every statement's result in one text, rendered by
                                                     Format-QueryResultText. Shown instead of the grid stack when the tab's mode
                                                     is Text. No wrapping, so the columns stay aligned; it scrolls both ways
                                                     instead. FillingTextBoxStyle keeps the implicit TextBox style's fixed
                                                     Width and Height off it, as for the Messages pane. -->
                                                <TextBox x:Name="TextBoxQueryResultText" Style="{StaticResource FillingTextBoxStyle}" Visibility="Collapsed"
                                                         IsReadOnly="True" IsReadOnlyCaretVisible="True" IsUndoEnabled="False"
                                                         FontFamily="Consolas" TextWrapping="NoWrap" AcceptsReturn="True"
                                                         BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                                </Grid>
                                                        </TabItem>
                                                        <TabItem Header="Messages">
                                                                <!-- A read-only TextBox rather than a TextBlock: issue #93 requires the error
                                                                     text to be selectable and copyable, which a TextBox gives without any
                                                                     selection handling of our own. -->
                                                                <TextBox x:Name="TextBoxQueryMessages" Style="{StaticResource FillingTextBoxStyle}"
                                                                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                                                         FontFamily="Consolas" TextWrapping="Wrap" AcceptsReturn="True"
                                                                         BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                                        </TabItem>
                                                </TabControl>
                                        </Grid>
                                </Grid>
                                <StatusBar Height="30" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="Khaki">
                                        <StatusBar.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                        <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                        <!-- Column 0 is the message. Its MinWidth is the floor the four Auto
                                                                             columns have to give way for: without it a narrow window lets
                                                                             their MinWidths add up to the whole bar and the message is back
                                                                             to a handful of characters (issue #118). -->
                                                                        <ColumnDefinition Width="*" MinWidth="180" />
                                                                        <ColumnDefinition Width="6" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="6" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="6" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="6" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                        </Grid>
                                                </ItemsPanelTemplate>
                                        </StatusBar.ItemsPanel>
                                        <!-- Every item stretches its content across the column it was given. StatusBarItem
                                             aligns content left by default, which would leave the message block at its
                                             desired width instead of the column's. -->
                                        <StatusBarItem Grid.Column="0" HorizontalContentAlignment="Stretch">
                                                <!-- The stretchy column. Carries the most recent state change on this tab -
                                                     connection, execution, completion - written only by Set-TabStatusMessage.
                                                     The explicit Style is what keeps the implicit TextBlock style's Width="100"
                                                     off this element; see StatusBarTextStyle in UserControl.Resources. It also
                                                     carries the TextTrimming, so no MaxWidth here: the message is the one item
                                                     on the bar that is allowed all the room that is left.

                                                     The ToolTip is bound to the block's own Text, so it always holds the full,
                                                     untrimmed message and no code assigns it. It cannot go stale when the text
                                                     changes. Whether it opens is decided at hover time by the ToolTipOpening
                                                     handler (MainFormTabContent.Elements.TextBlockStatusBarMessage.ps1), which
                                                     cancels it unless the text is trimmed at the width the block has right
                                                     then. Deciding at hover time is what keeps a window resize from leaving a
                                                     wrong answer behind (issue #119).

                                                     ShowDuration is pinned rather than inherited. On this app's runtime
                                                     (.NET 10) the registered default is already Int32.MaxValue, not the five
                                                     seconds of the .NET Framework documentation. Pinning it states what the
                                                     bar needs instead of depending on a default that has changed before. -->
                                                <TextBlock Name="TextBlockStatusBarMessage" Text="Disconnected" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" ToolTipService.ShowDuration="2147483647" Style="{StaticResource StatusBarTextStyle}" />
                                        </StatusBarItem>
                                        <Separator Grid.Column="1" Background="Gray" Opacity="0.50" Margin="2,5,2,5" />
                                        <StatusBarItem Grid.Column="2" HorizontalContentAlignment="Stretch">
                                                <!-- MaxWidth is the ceiling Auto never had. A tenant URL is long and constant;
                                                     past this width it is trimmed rather than charged to the message. -->
                                                <TextBlock Name="TextBlockStatusBarUrl" Text="-" MinWidth="135" MaxWidth="260" Style="{StaticResource StatusBarTextStyle}" />
                                        </StatusBarItem>
                                        <Separator Grid.Column="3" Background="Gray" Opacity="0.50" Margin="2,5,2,5" />
                                        <StatusBarItem Grid.Column="4" HorizontalContentAlignment="Stretch">
                                                <TextBlock Name="TextBlockStatusBarDatabaseName" Text="-" MinWidth="135" MaxWidth="260" Style="{StaticResource StatusBarTextStyle}" />
                                        </StatusBarItem>
                                        <Separator Grid.Column="5" Background="Gray" Opacity="0.50" Margin="2,5,2,5" />
                                        <StatusBarItem Grid.Column="6" HorizontalContentAlignment="Stretch">
                                                <!-- The Text here is a design-time placeholder only: every runtime write comes
                                                     from Format-ElapsedTime, which renders hh:mm:ss.f - one fractional digit,
                                                     with hours growing past two rather than rolling over at 24. Measured in
                                                     Segoe UI 12: "00:00:02.3" is 53px and even "9999:59:59.9" (416 days) is
                                                     66px, so 120 clears the widest form with room over. MinWidth=100 is what
                                                     stops the column resizing under the indicator while it counts. -->
                                                <TextBlock Name="TextBlockStatusBarQueryTime" Text="00:00:00.0000000" MinWidth="100" MaxWidth="120" Style="{StaticResource StatusBarTextStyle}" />
                                        </StatusBarItem>
                                        <Separator Grid.Column="7" Background="Gray" Opacity="0.50" Margin="2,5,2,5" />
                                        <StatusBarItem Grid.Column="8" HorizontalContentAlignment="Stretch">
                                                <!-- Invoke-ExecuteQuery writes "{0:n0} rows" over an [Int], so the widest value
                                                     this can hold is "2,147,483,647 rows" - 101px measured, thousands
                                                     separators included. 110 clears it; 90 did not, and would have ellipsised
                                                     the row count on the one screen that exists to report it. The column is
                                                     Auto, so the extra 20px costs the message nothing until the text is
                                                     actually that long. -->
                                                <TextBlock Name="TextBlockStatusBarRows" Text="0 rows" MinWidth="50" MaxWidth="110" Style="{StaticResource StatusBarTextStyle}" />
                                        </StatusBarItem>
                                </StatusBar>

                        </Grid>
        </Grid>
</UserControl>
