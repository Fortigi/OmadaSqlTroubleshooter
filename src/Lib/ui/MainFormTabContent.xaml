<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" x:Name="MainFormTabContent">

        <UserControl.Resources>
                <Style TargetType="TextBox">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Height" Value="25" />
                        <Setter Property="Width" Value="300" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </Style>
                <!-- The implicit style above pins EVERY TextBox in this control to 300x25 for the
                     connection fields, which is why the Messages pane rendered as a small centred
                     block however hard its own markup asked to stretch (issue #116): a Width or a
                     Height from a style beats HorizontalAlignment/VerticalAlignment="Stretch".
                     A TextBox that carries an explicit Style does not get the implicit one at all,
                     so this keyed style is what keeps the pane free of the fixed size - and free of
                     whatever the implicit style grows next. It therefore sets no Width and no
                     Height on purpose. -->
                <Style x:Key="FillingTextBoxStyle" TargetType="TextBox">
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </Style>
                <Style TargetType="PasswordBox">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Height" Value="25" />
                        <Setter Property="Width" Value="300" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </Style>
                <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Setter Property="Height" Value="25" />
                        <Setter Property="MinHeight" Value="25" />
                        <Setter Property="Width" Value="100" />
                        <Setter Property="MinWidth" Value="100" />
                </Style>
                <Style TargetType="CheckBox">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Setter Property="Height" Value="25" />
                        <Setter Property="MinHeight" Value="25" />
                        <Setter Property="Width" Value="100" />
                        <Setter Property="MinWidth" Value="100" />
                </Style>
                <Style TargetType="ComboBox">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="MinHeight" Value="25" />
                        <Setter Property="Height" Value="25" />
                        <Setter Property="MinWidth" Value="300" />
                        <Setter Property="Width" Value="300" />
                </Style>
                <Style TargetType="Button">
                        <Setter Property="Height" Value="25" />
                        <Setter Property="MinHeight" Value="25" />
                        <Setter Property="Width" Value="98" />
                        <Setter Property="MinWidth" Value="98" />
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Padding" Value="2,3" />
                </Style>
                <Style x:Key="ButtonAccessTextStyle" TargetType="AccessText">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="TextAlignment" Value="Center" />
                        <Setter Property="Height" Value="25" />
                        <Setter Property="Width" Value="100" />
                        <Setter Property="MinWidth" Value="100" />
                        <Setter Property="FontSize" Value="12" />
                </Style>
                <Style x:Key="ToolbarGlyphStyle" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Width" Value="15" />
                        <Setter Property="MinWidth" Value="15" />
                        <Setter Property="Height" Value="15" />
                        <Setter Property="MinHeight" Value="15" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="TextAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="#1F1F1F" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                </Style>

                <!-- The status bar's five TextBlocks. Same trap as the Messages pane in issue #116:
                     the implicit <Style TargetType="TextBlock"> above pins Width to 100 for the form's
                     field labels, and an implicit style reaches every TextBlock in this control - so
                     the message block rendered exactly 100px wide no matter how much room its column
                     had. Measured on the unfixed markup in a real WPF layout pass, at MainForm's own
                     MinWidth of 1461: column 0 arranged to 943px while TextBlockStatusBarMessage sat
                     at 100px and CharacterEllipsis cut the text to "Query 'MvE: Rop...". The column
                     was never starved; the TextBlock simply refused to use it (issue #118).
                     A TextBlock that carries an explicit Style does not get the implicit one at all,
                     so this keyed style sets no Width and no Height on purpose, and stretches instead.
                     TextTrimming belongs here too: every item on the bar can overflow, and a clipped
                     half-character reads as a rendering fault where an ellipsis reads as "there is
                     more". Per-element MaxWidth caps the four Auto columns so a long tenant URL or
                     data connection name still cannot eat the message's column. -->
                <Style x:Key="StatusBarTextStyle" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>

                <Style x:Key="CheckboxAccessTextStyle" TargetType="AccessText">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextAlignment" Value="Left" />
                        <Setter Property="Height" Value="25" />
                        <Setter Property="MinHeight" Value="25" />
                        <Setter Property="Width" Value="100" />
                        <Setter Property="MinWidth" Value="100" />
                </Style>
                <Style x:Key="DefaultSeparatorStyle" TargetType="Separator">
                        <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style x:Key="DefaultWidthSeparatorStyle" TargetType="Separator" BasedOn="{StaticResource DefaultSeparatorStyle}">
                        <Setter Property="MinWidth" Value="15" />
                </Style>
                <Style x:Key="DefaultButtonWidthSeparatorStyle" TargetType="Separator" BasedOn="{StaticResource DefaultSeparatorStyle}">
                        <Setter Property="MinWidth" Value="20" />
                </Style>
                <Style x:Key="DefaultHeightSeparator" TargetType="Separator" BasedOn="{StaticResource DefaultSeparatorStyle}">
                        <Setter Property="MinWidth" Value="5" />
                </Style>
                <Style x:Key="LeftBorderWidthSeparatorStyle" TargetType="Separator" BasedOn="{StaticResource DefaultSeparatorStyle}">
                        <Setter Property="MinWidth" Value="10" />
                </Style>
                <Style x:Key="ButtontBorderWidthSeparatorStyle" TargetType="Separator" BasedOn="{StaticResource DefaultSeparatorStyle}">
                        <Setter Property="MinWidth" Value="19" />
                </Style>

                <Style TargetType="DataGridRowHeader">
                        <Setter Property="MinWidth" Value="40" />
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRowHeader">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                        <Grid>
                                                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Normal" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                                        </Grid>
                                                        <Border.ToolTip>
                                                                <ToolTip Content="Click top-left corner to reset sort order" />
                                                        </Border.ToolTip>
                                                </Border>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
        </UserControl.Resources>

        <!-- The navy frame around the content lives in MainForm.xaml's TabControl template now, so
             the tab strip and this content share one frame; this content is frame-less. -->
        <Grid x:Name="MainGrid" KeyboardNavigation.TabNavigation="Continue" Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
                        <Grid Margin="0">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="30" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0" Grid.Row="0">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="6" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Vertical" Grid.Row="0">
                                                <StackPanel Orientation="Horizontal">
                                                        <Separator Style="{StaticResource DefaultSeparatorStyle}" Height="6" />
                                                </StackPanel>
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Grid.Column="0">
                                                                <Grid Margin="5">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="10" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="TextBlockUrl" Text="Tenant:" ToolTip="Omada Tenant url. Enter full URL or tenant name only. Example: Enter 'comp' for 'https://comp.omada.cloud'" />
                                                                        <TextBox Grid.Column="3" x:Name="TextBoxURL" TabIndex="1" ToolTip="Enter full URL or tenant name only. Example: Enter 'comp' for 'https://comp.omada.cloud'" />
                                                                        <TextBlock Grid.Column="5" x:Name="TextBlockUserName" Text="Username:" ToolTip="Username:" Visibility="Hidden" />
                                                                        <TextBox Grid.Column="7" x:Name="TextBoxUserName" TabIndex="3" Visibility="Hidden" IsEnabled="False" />
                                                                        <TextBlock Grid.Column="9" x:Name="TextBlockAppIdUri" Text="App Uri:" Visibility="Hidden" ToolTip="Application ID Uri:" />
                                                                        <TextBox Grid.Column="11" x:Name="TextBoxAppIdUri" TabIndex="5" IsEnabled="False" Visibility="Hidden" />
                                                                </Grid>
                                                                <Grid Margin="5">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="10" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" Text="Authentication:" VerticalAlignment="Center" />
                                                                        <ComboBox Grid.Column="3" x:Name="ComboBoxSelectAuthenticationOption" SelectedIndex="0" TabIndex="2" VerticalAlignment="Center">
                                                                                <ComboBoxItem Content="Browser" />
                                                                                <ComboBoxItem Content="WebView2" />
                                                                                <ComboBoxItem Content="OAuth" />
                                                                                <ComboBoxItem Content="Browser-InPrivate" />
                                                                                <ComboBoxItem Content="WebView2-InPrivate" />
                                                                        </ComboBox>
                                                                        <TextBlock Grid.Column="5" x:Name="TextBlockPassword" Text="Password:" Visibility="Hidden" VerticalAlignment="Center" />
                                                                        <PasswordBox Grid.Column="7" x:Name="TextBoxPassword" TabIndex="4" Visibility="Hidden" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="9" x:Name="TextBlockEntraIdTenantId" Text="Entra Tenant ID:" Visibility="Hidden" VerticalAlignment="Center" />
                                                                        <TextBox Grid.Column="11" x:Name="TextBoxEntraIdTenantId" Visibility="Hidden" TabIndex="6" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Grid Margin="5">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="10" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="TextBlockComboBoxSelectQuery" Text="Query:" ToolTip="Query list" />
                                                                        <ComboBox Grid.Column="3" x:Name="ComboBoxSelectQuery" TabIndex="7" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" />
                                                                        <TextBlock Grid.Column="5" Text="Save Password:" />
                                                                        <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <CheckBox x:Name="CheckBoxSavePassword" TabIndex="8" />
                                                                        </StackPanel>
                                                                </Grid>
                                                                <Grid Margin="5" VerticalAlignment="Center">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="10" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="15" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="TextBlockDisplayName" Text="Display name:" ToolTip="The Display Name of a query, the display name can be changed if needed." />
                                                                        <TextBox Grid.Column="3" x:Name="TextBoxDisplayName" IsEnabled="False" TabIndex="9" />
                                                                        <TextBlock Grid.Column="5" Text="Filter my queries:" Grid.RowSpan="5" />
                                                                        <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <CheckBox x:Name="CheckboxMyCreatedQueries" TabIndex="10" Content="Crea_ted" />
                                                                                <CheckBox x:Name="CheckboxMyUpdatedQueries" TabIndex="11" Content="Last _Updated" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="9" Width="85" MinWidth="85" />
                                                                        <TextBlock Grid.Column="11" x:Name="TextBlockDataConnection" Text="Connection:" ToolTip="Data Connection" />
                                                                        <ComboBox Grid.Column="13" x:Name="ComboBoxSelectDataConnection" TabIndex="12" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" />
                                                                </Grid>
                                                        </StackPanel>
                                                </Grid>
                                        </StackPanel>
                                        <Separator Style="{StaticResource DefaultHeightSeparator}" Grid.Row="1" />
                                        <StackPanel Orientation="Horizontal" Grid.Row="2">
                                                <Separator Style="{StaticResource ButtontBorderWidthSeparatorStyle}" />
                                                <Button x:Name="ButtonNewQuery" TabIndex="13" ToolTip="Creates a new query object in Omada">
                                                        <Border Background="Transparent" IsHitTestVisible="False">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" IsHitTestVisible="False">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="40" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="ButtonNewQueryImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE8E5;" />
                                                                        <AccessText Grid.Column="3" IsHitTestVisible="False" x:Name="ButtonNewQueryText" Text="_New" Style="{StaticResource ButtonAccessTextStyle}" />
                                                                </Grid>
                                                        </Border>
                                                </Button>

                                                <Separator Style="{StaticResource DefaultButtonWidthSeparatorStyle}" />
                                                <Button x:Name="ButtonRefreshQueries" TabIndex="14" IsEnabled="True" ToolTip="Refresh query list">
                                                        <Border Background="Transparent" IsHitTestVisible="False">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" IsHitTestVisible="False">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="40" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="ButtonRefreshQueriesImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE72C;" />
                                                                        <AccessText Grid.Column="3" IsHitTestVisible="False" x:Name="ButtonRefreshQueriesText" Text="_Refresh" Style="{StaticResource ButtonAccessTextStyle}" />
                                                                </Grid>
                                                        </Border>
                                                </Button>

                                                <Separator Style="{StaticResource DefaultButtonWidthSeparatorStyle}" />
                                                <Button x:Name="ButtonShowSqlSchema" TabIndex="15" ToolTip="Show Sql Schema">
                                                        <Border Background="Transparent" IsHitTestVisible="False">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" IsHitTestVisible="False">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="40" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="ButtonShowSqlSchemaImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE8FD;" />
                                                                        <AccessText Grid.Column="3" IsHitTestVisible="False" x:Name="ButtonShowSqlSchemaText" Text="Sche_ma" Style="{StaticResource ButtonAccessTextStyle}" />
                                                                </Grid>
                                                        </Border>
                                                </Button>

                                                <Separator Style="{StaticResource DefaultButtonWidthSeparatorStyle}" />
                                                <Button x:Name="ButtonSaveQuery" TabIndex="16" ToolTip="Save query in Omada">
                                                        <Border Background="Transparent" IsHitTestVisible="False">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" IsHitTestVisible="False">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="40" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="ButtonSaveQueryImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE74E;" />
                                                                        <AccessText Grid.Column="3" IsHitTestVisible="False" x:Name="ButtonSaveQueryText" Text="_Save" Style="{StaticResource ButtonAccessTextStyle}" />
                                                                </Grid>
                                                        </Border>
                                                </Button>

                                                <Separator Style="{StaticResource DefaultButtonWidthSeparatorStyle}" />
                                                <Button x:Name="ButtonExecuteQuery" TabIndex="17" ToolTip="Execute">
                                                        <Border Background="Transparent" IsHitTestVisible="False">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" IsHitTestVisible="False">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="40" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="ButtonExecuteQueryImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE768;" />
                                                                        <AccessText Grid.Column="3" IsHitTestVisible="False" x:Name="ButtonExecuteQueryText" Text="_Execute" Style="{StaticResource ButtonAccessTextStyle}" />
                                                                </Grid>
                                                        </Border>
                                                </Button>

                                                <Separator Style="{StaticResource DefaultButtonWidthSeparatorStyle}" />
                                                <Button x:Name="ButtonShowHistory" TabIndex="18" IsEnabled="True" ToolTip="Show history window">
                                                        <Border Background="Transparent" IsHitTestVisible="False">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" IsHitTestVisible="False">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="40" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="ButtonShowHistoryImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE81C;" />
                                                                        <AccessText Grid.Column="3" IsHitTestVisible="False" x:Name="ButtonShowHistoryText" Text="_History" Style="{StaticResource ButtonAccessTextStyle}" />
                                                                </Grid>
                                                        </Border>
                                                </Button>
                                                <Separator Style="{StaticResource ButtontBorderWidthSeparatorStyle}" />
                                                <Button x:Name="ButtonShowOutput" TabIndex="19" ToolTip="View result in a new window">
                                                        <Border Background="Transparent" IsHitTestVisible="False">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" IsHitTestVisible="False">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="40" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="ButtonShowOutputImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE890;" />
                                                                        <AccessText Grid.Column="3" IsHitTestVisible="False" x:Name="ButtonShowOutputText" Text="_View" Style="{StaticResource ButtonAccessTextStyle}" />
                                                                </Grid>
                                                        </Border>
                                                </Button>

                                                <Separator Style="{StaticResource DefaultButtonWidthSeparatorStyle}" />
                                                <Button x:Name="ButtonSaveOutputFile" TabIndex="20" ToolTip="Export result to a file">
                                                        <Border Background="Transparent" IsHitTestVisible="False">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" IsHitTestVisible="False">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="40" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="ButtonSaveOutputFileImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xEDE1;" />
                                                                        <AccessText Grid.Column="3" IsHitTestVisible="False" x:Name="ButtonSaveOutputFileText" Text="E_xport" Style="{StaticResource ButtonAccessTextStyle}" />
                                                                </Grid>
                                                        </Border>
                                                </Button>

                                                <Separator Style="{StaticResource DefaultButtonWidthSeparatorStyle}" />
                                                <Button x:Name="ButtonOpenOutputFile" TabIndex="21" ToolTip="Open export file">
                                                        <Border Background="Transparent" IsHitTestVisible="False">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" IsHitTestVisible="False">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="70" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="ButtonOpenOutputFileImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE8A7;" />
                                                                        <AccessText Grid.Column="3" IsHitTestVisible="False" x:Name="ButtonOpenOutputFileText" Text="_Open Export" Style="{StaticResource ButtonAccessTextStyle}" />
