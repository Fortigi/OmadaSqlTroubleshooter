                                                        </Border>
                                                </Button>

                                                <Separator Style="{StaticResource DefaultButtonWidthSeparatorStyle}" />
                                                <Button x:Name="ButtonConnect" TabIndex="22" ToolTip="Connect to Omada">
                                                        <Border Background="Transparent" IsHitTestVisible="False">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" IsHitTestVisible="False">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="70" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="ButtonConnectImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE8FA;" />
                                                                        <AccessText Grid.Column="3" IsHitTestVisible="False" x:Name="ButtonConnectText" Text="_Connect" Style="{StaticResource ButtonAccessTextStyle}" />
                                                                </Grid>
                                                        </Border>
                                                </Button>
                                                <Separator Style="{StaticResource DefaultButtonWidthSeparatorStyle}" />
                                                <Button x:Name="ButtonReset" TabIndex="23" IsEnabled="True" ToolTip="Reset application">
                                                        <Border Background="Transparent" IsHitTestVisible="False">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" IsHitTestVisible="False">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="40" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="1" x:Name="ButtonResetImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE777;" />
                                                                        <AccessText Grid.Column="3" IsHitTestVisible="False" x:Name="ButtonResetText" Text="Reset" Style="{StaticResource ButtonAccessTextStyle}" />
                                                                </Grid>
                                                        </Border>
                                                </Button>

                                                <Separator Style="{StaticResource DefaultButtonWidthSeparatorStyle}" />
                                                <Button x:Name="ButtonShowLog" TabIndex="24" IsEnabled="True" ToolTip="Show log window">
                                                        <Border Background="Transparent" IsHitTestVisible="False">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" IsHitTestVisible="False">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="4" />
