<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" x:Name="MainFormTabContent">

        <UserControl.Resources>
                <Style TargetType="TextBox">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Height" Value="25" />
                        <Setter Property="Width" Value="300" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </Style>
                <!-- The implicit style above pins EVERY TextBox in this control to 300x25 for the
                     connection fields, which is why the Messages pane rendered as a small centred
                     block however hard its own markup asked to stretch (issue #116): a Width or a
                     Height from a style beats HorizontalAlignment/VerticalAlignment="Stretch".
                     A TextBox that carries an explicit Style does not get the implicit one at all,
                     so this keyed style is what keeps the pane free of the fixed size - and free of
                     whatever the implicit style grows next. It therefore sets no Width and no
                     Height on purpose. -->
                <Style x:Key="FillingTextBoxStyle" TargetType="TextBox">
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </Style>
                <Style TargetType="PasswordBox">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Height" Value="25" />
                        <Setter Property="Width" Value="300" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </Style>
                <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Setter Property="Height" Value="25" />
                        <Setter Property="MinHeight" Value="25" />
                        <Setter Property="Width" Value="100" />
                        <Setter Property="MinWidth" Value="100" />
                </Style>
                <Style TargetType="CheckBox">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Setter Property="Height" Value="25" />
                        <Setter Property="MinHeight" Value="25" />
                        <Setter Property="Width" Value="100" />
                        <Setter Property="MinWidth" Value="100" />
                </Style>
                <Style TargetType="ComboBox">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="MinHeight" Value="25" />
                        <Setter Property="Height" Value="25" />
                        <Setter Property="MinWidth" Value="300" />
                        <Setter Property="Width" Value="300" />
                </Style>
                <Style TargetType="Button">
                        <Setter Property="Height" Value="25" />
                        <Setter Property="MinHeight" Value="25" />
                        <Setter Property="Width" Value="98" />
                        <Setter Property="MinWidth" Value="98" />
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Padding" Value="2,3" />
                </Style>
                <Style x:Key="ToolbarGlyphStyle" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Width" Value="15" />
                        <Setter Property="MinWidth" Value="15" />
                        <Setter Property="Height" Value="15" />
                        <Setter Property="MinHeight" Value="15" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="TextAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="#1F1F1F" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                </Style>

                <!-- The toolbar (issue: buttons wider than the screen). Flat, icon-first buttons in
                     groups, as in SQL Server Management Studio. BasedOn the implicit Button style so a
                     toolbar button keeps its IsEnabled="False" default - every button is enabled by
                     code, see MainFormTabContentButtonEnabled.Tests.ps1 - and only its size and look
                     change. The commands are also on the menu bar (MainForm.xaml), which is where the
                     keyboard access keys live now. -->
                <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="MinWidth" Value="26" />
                        <Setter Property="Height" Value="26" />
                        <Setter Property="MinHeight" Value="26" />
                        <Setter Property="Margin" Value="1,0" />
                        <Setter Property="Padding" Value="5,2" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Foreground" Value="#1F1F1F" />
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ToolbarButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ToolbarButtonBorder" Property="Background" Value="#FFD5E7F7" />
                                                                <Setter TargetName="ToolbarButtonBorder" Property="BorderBrush" Value="#FF7EB4EA" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="ToolbarButtonBorder" Property="Background" Value="#FFC4DDF4" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="ToolbarButtonBorder" Property="BorderBrush" Value="#FF3399FF" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.4" />
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
                <Style x:Key="ToolbarTextStyle" TargetType="AccessText">
                        <Setter Property="Margin" Value="5,0,1,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="FontSize" Value="12" />
                </Style>
                <!-- A group divider: SSMS separates its toolbar groups with a thin vertical line. -->
                <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
                        <Setter Property="Width" Value="1" />
                        <Setter Property="Margin" Value="6,4" />
                        <Setter Property="Background" Value="#FFB0B7C0" />
                </Style>
                <Style x:Key="ToolbarCheckBoxStyle" TargetType="CheckBox">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="4,0" />
                </Style>
                <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="6,0,2,0" />
                        <Setter Property="Foreground" Value="#FF4A4A4A" />
                </Style>

                <!-- The status bar's five TextBlocks. Same trap as the Messages pane in issue #116:
                     the implicit <Style TargetType="TextBlock"> above pins Width to 100 for the form's
                     field labels, and an implicit style reaches every TextBlock in this control - so
                     the message block rendered exactly 100px wide no matter how much room its column
                     had. Measured on the unfixed markup in a real WPF layout pass, at MainForm's own
                     MinWidth of 1461: column 0 arranged to 943px while TextBlockStatusBarMessage sat
                     at 100px and CharacterEllipsis cut the text to "Query 'MvE: Rop...". The column
                     was never starved; the TextBlock simply refused to use it (issue #118).
                     A TextBlock that carries an explicit Style does not get the implicit one at all,
                     so this keyed style sets no Width and no Height on purpose, and stretches instead.
                     TextTrimming belongs here too: every item on the bar can overflow, and a clipped
                     half-character reads as a rendering fault where an ellipsis reads as "there is
                     more". Per-element MaxWidth caps the four Auto columns so a long tenant URL or
                     data connection name still cannot eat the message's column. -->
                <Style x:Key="StatusBarTextStyle" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>

                <Style x:Key="CheckboxAccessTextStyle" TargetType="AccessText">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextAlignment" Value="Left" />
                        <Setter Property="Height" Value="25" />
                        <Setter Property="MinHeight" Value="25" />
                        <Setter Property="Width" Value="100" />
                        <Setter Property="MinWidth" Value="100" />
                </Style>
                <Style x:Key="DefaultSeparatorStyle" TargetType="Separator">
                        <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style x:Key="DefaultWidthSeparatorStyle" TargetType="Separator" BasedOn="{StaticResource DefaultSeparatorStyle}">
                        <Setter Property="MinWidth" Value="15" />
                </Style>
                <Style x:Key="LeftBorderWidthSeparatorStyle" TargetType="Separator" BasedOn="{StaticResource DefaultSeparatorStyle}">
                        <Setter Property="MinWidth" Value="10" />
                </Style>

                <Style TargetType="DataGridRowHeader">
                        <Setter Property="MinWidth" Value="40" />
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRowHeader">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                        <Grid>
                                                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Normal" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                                        </Grid>
                                                        <Border.ToolTip>
                                                                <ToolTip Content="Click top-left corner to reset sort order" />
                                                        </Border.ToolTip>
                                                </Border>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
                <!-- The Results grid's context menu, as a SHARED resource rather than a child of one
                     DataGrid (issue #151). The Results pane now holds one grid per statement, and the
                     menu cannot move into the per-result DataTemplate: Initialize-UiComponents binds
                     its seven items POSITIONALLY off ContextMenu.Items, and names declared inside a
                     template do not reach FindName at all. One instance, attached to every result
                     grid, keeps that binding working exactly as it did.

                     A ContextMenu is a popup rather than a visual child, so sharing one instance
                     across several elements is legal; PlacementTarget is what identifies the grid the
                     user actually right-clicked.

                     ITEM ORDER IS LOAD-BEARING. Initialize-UiComponents takes Copy, Copy with
                     Headers, Copy As, Select All, Save Results As, Save Selected As and View Selected
                     as items 0-6, and the two Copy As children as 0-1. Reordering this markup
                     silently repoints Copy at a different command. -->
                                                                <ContextMenu x:Key="DataGridQueryResultContextMenu" FontFamily="Segoe UI" FontSize="13" Foreground="#1F1F1F">
                                                                        <ContextMenu.Template>
                                                                                <ControlTemplate TargetType="ContextMenu">
                                                                                        <Border Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Margin="6" SnapsToDevicePixels="True">
                                                                                                <Border.Effect>
                                                                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Color="Black"/>
                                                                                                </Border.Effect>
                                                                                                <ItemsPresenter Margin="0,4"/>
                                                                                        </Border>
                                                                                </ControlTemplate>
                                                                        </ContextMenu.Template>
                                                                        <ContextMenu.Resources>
                                                                                <ControlTemplate x:Key="DataGridQueryResultFlatMenuItem" TargetType="MenuItem">
                                                                                        <Border x:Name="Border" Background="Transparent" Padding="12,8">
                                                                                                <Grid>
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="18"/>
                                                                                                                <ColumnDefinition Width="12"/>
                                                                                                                <ColumnDefinition Width="*"/>
                                                                                                                <ColumnDefinition Width="16"/>
                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                        </Grid.ColumnDefinitions>
                                                                                                        <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                                                        <ContentPresenter Grid.Column="2" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                                                                                        <TextBlock Grid.Column="4" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Opacity="0.75"/>
                                                                                                </Grid>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                                <Trigger Property="IsHighlighted" Value="True">
                                                                                                        <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                                                                                                </Trigger>
                                                                                                <Trigger Property="IsEnabled" Value="False">
                                                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                                                </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                                <ControlTemplate x:Key="DataGridQueryResultFlatMenuItemWithSubmenu" TargetType="MenuItem">
                                                                                        <Border x:Name="Border" Background="Transparent" Padding="12,8">
                                                                                                <Grid>
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="18"/>
                                                                                                                <ColumnDefinition Width="12"/>
                                                                                                                <ColumnDefinition Width="*"/>
                                                                                                                <ColumnDefinition Width="16"/>
                                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                                <ColumnDefinition Width="16"/>
                                                                                                        </Grid.ColumnDefinitions>
                                                                                                        <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                                                        <ContentPresenter Grid.Column="2" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                                                                                        <TextBlock Grid.Column="4" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Opacity="0.75"/>
                                                                                                        <TextBlock Grid.Column="5" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                                                                        <Popup x:Name="SubmenuPopup" Placement="Right" HorizontalOffset="-4" VerticalOffset="-8" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                                                                                                <Border x:Name="SubmenuBorder" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="4">
                                                                                                                        <Border.Effect>
                                                                                                                                <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="12" ShadowDepth="2"/>
                                                                                                                        </Border.Effect>
                                                                                                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
                                                                                                                </Border>
                                                                                                        </Popup>
                                                                                                </Grid>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                                <Trigger Property="IsHighlighted" Value="True">
                                                                                                        <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                                                                                                </Trigger>
                                                                                                <Trigger Property="IsEnabled" Value="False">
                                                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                                                </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                                <Style TargetType="Separator">
                                                                                        <Setter Property="Template">
                                                                                                <Setter.Value>
                                                                                                        <ControlTemplate TargetType="Separator">
                                                                                                                <Border Height="1" Margin="12,4" Background="#E5E7EB"/>
                                                                                                        </ControlTemplate>
                                                                                                </Setter.Value>
                                                                                        </Setter>
                                                                                </Style>
                                                                        </ContextMenu.Resources>
                                                                        <MenuItem x:Name="DataGridQueryResultMenuItemCopy" Header="Copy" InputGestureText="Ctrl+C" Template="{StaticResource DataGridQueryResultFlatMenuItem}">
                                                                                <MenuItem.Icon>
                                                                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE8C8;" Foreground="#4B5563"/>
                                                                                </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem x:Name="DataGridQueryResultMenuItemCopyWithHeaders" Header="Copy with Headers" InputGestureText="Ctrl+Shift+C" Template="{StaticResource DataGridQueryResultFlatMenuItem}">
                                                                                <MenuItem.Icon>
                                                                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE8C8;" Foreground="#4B5563"/>
                                                                                </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem x:Name="DataGridQueryResultMenuItemCopyAs" Header="Copy As..." Template="{StaticResource DataGridQueryResultFlatMenuItemWithSubmenu}">
                                                                                <MenuItem x:Name="DataGridQueryResultMenuItemCopyAsSqlArray" Header="Sql Array" InputGestureText="Ctrl+Shift+S" Template="{StaticResource DataGridQueryResultFlatMenuItem}">
                                                                                        <MenuItem.Icon>
                                                                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xEA37;" Foreground="#4B5563"/>
                                                                                        </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem x:Name="DataGridQueryResultMenuItemCopyAsPowerShellArray" Header="PowerShell Array" InputGestureText="Ctrl+Shift+P" Template="{StaticResource DataGridQueryResultFlatMenuItem}">
                                                                                        <MenuItem.Icon>
                                                                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE756;" Foreground="#4B5563"/>
                                                                                        </MenuItem.Icon>
                                                                                </MenuItem>
                                                                        </MenuItem>
                                                                        <MenuItem x:Name="DataGridQueryResultMenuItemSelectAll" Header="Select All" InputGestureText="Ctrl+A" Template="{StaticResource DataGridQueryResultFlatMenuItem}">
                                                                                <MenuItem.Icon>
                                                                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE8B3;" Foreground="#4B5563"/>
                                                                                </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <Separator/>
                                                                        <MenuItem x:Name="DataGridQueryResultMenuItemSaveAs" Header="Save Results As..." Template="{StaticResource DataGridQueryResultFlatMenuItem}">
                                                                                <MenuItem.Icon>
                                                                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE74E;" Foreground="#4B5563"/>
                                                                                </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem x:Name="DataGridQueryResultMenuItemSaveSelectedAs" Header="Save Selected As..." Template="{StaticResource DataGridQueryResultFlatMenuItem}">
                                                                                <MenuItem.Icon>
                                                                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE74E;" Foreground="#4B5563"/>
                                                                                </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem x:Name="DataGridQueryResultMenuItemViewSelected" Header="View Selected" Template="{StaticResource DataGridQueryResultFlatMenuItem}">
                                                                                <MenuItem.Icon>
                                                                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE890;" Foreground="#4B5563"/>
                                                                                </MenuItem.Icon>
                                                                        </MenuItem>
                                                                </ContextMenu>
                <!-- The header above each per-statement result grid (issue #151). It carries an
                     explicit Style for exactly the reason the Messages pane does (issues #116, #118):
                     the implicit <Style TargetType="TextBlock"> at the top of this dictionary pins
                     Width to 100 and Height to 25 for the form's field labels, an implicit style
                     reaches every TextBlock in this control, and a Width that resolves to a number
                     beats HorizontalAlignment="Stretch". A TextBlock with an explicit Style is never
                     given the implicit one, so this sets no Width and no Height on purpose. -->
                <Style x:Key="QueryResultHeaderStyle" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <!-- One line, cut off at the window edge: the header carries the statement's
                             query on one line, and the tooltip shows all of it. -->
                        <Setter Property="TextWrapping" Value="NoWrap" />
                        <Setter Property="Background" Value="#F1F5F9" />
                </Style>
        </UserControl.Resources>

        <!-- The navy frame around the content lives in MainForm.xaml's TabControl template now, so
             the tab strip and this content share one frame; this content is frame-less. -->
        <Grid x:Name="MainGrid" KeyboardNavigation.TabNavigation="Continue" Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
                        <Grid Margin="0">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="30" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0" Grid.Row="0">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="6" />
                                        </Grid.RowDefinitions>
                                        <!-- Toolbar: grouped like SQL Server Management Studio's, icon-first, every command also on the
                                             menu bar. A WrapPanel rather than a single row so a narrow window wraps the groups onto a
                                             second line instead of pushing buttons off the screen. Each group is one StackPanel so it
                                             wraps as a whole. -->
                                        <!-- Its own lighter band with a line under it, so it reads as a toolbar against the grey
                                             form below (as in SSMS). The resources undo two of this control's implicit styles inside
                                             the toolbar: the TextBlock one pins every TextBlock to 100x25 - which includes the text
                                             inside each button's AccessText and the CheckBoxes' content - and the CheckBox one pins
                                             100 wide too, which spread the groups out over the window instead of packing them left. -->
                                        <Border Grid.Row="0" x:Name="BorderToolbar" Background="#FFF5F6F7" BorderBrush="#FFB0B7C0" BorderThickness="0,1,0,1" Padding="4,3">
                                                <Border.Resources>
                                                        <Style TargetType="TextBlock" />
                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource ToolbarCheckBoxStyle}" />
                                                </Border.Resources>
                                                <WrapPanel x:Name="WrapPanelToolbar" Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <!-- Query: the query in this tab -->
                                                        <StackPanel Orientation="Horizontal">
                                                                <Button x:Name="ButtonNewQuery" TabIndex="13" ToolTip="New query: clears the editor (offers to save unsaved changes first)" Style="{StaticResource ToolbarButtonStyle}">
                                                                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                                                <TextBlock x:Name="ButtonNewQueryImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE8E5;" />
                                                                                <AccessText x:Name="ButtonNewQueryText" Text="_New query" Style="{StaticResource ToolbarTextStyle}" />
                                                                        </StackPanel>
                                                                </Button>
                                                                <Button x:Name="ButtonSaveQuery" TabIndex="14" ToolTip="Save the query in Omada (Ctrl+S)" Style="{StaticResource ToolbarButtonStyle}">
                                                                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                                                <TextBlock x:Name="ButtonSaveQueryImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE74E;" />
                                                                                <AccessText x:Name="ButtonSaveQueryText" Text="Save" Style="{StaticResource ToolbarTextStyle}" Visibility="Collapsed" />
                                                                        </StackPanel>
                                                                </Button>
                                                                <Button x:Name="ButtonSaveQueryAs" TabIndex="15" ToolTip="Save as: save the editor as another, new query (asks for a name)" Style="{StaticResource ToolbarButtonStyle}">
                                                                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                                                <TextBlock x:Name="ButtonSaveQueryAsImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE792;" />
                                                                                <AccessText x:Name="ButtonSaveQueryAsText" Text="Save as" Style="{StaticResource ToolbarTextStyle}" Visibility="Collapsed" />
                                                                        </StackPanel>
                                                                </Button>
                                                                <Button x:Name="ButtonRenameQuery" TabIndex="16" ToolTip="Rename the selected query in Omada" Style="{StaticResource ToolbarButtonStyle}">
                                                                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                                                <TextBlock x:Name="ButtonRenameQueryImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE8AC;" />
                                                                                <AccessText x:Name="ButtonRenameQueryText" Text="Rename" Style="{StaticResource ToolbarTextStyle}" Visibility="Collapsed" />
                                                                        </StackPanel>
                                                                </Button>
                                                                <Button x:Name="ButtonDeleteQuery" TabIndex="17" ToolTip="Delete the selected query from Omada; its text stays in the editor as an ad-hoc query" Style="{StaticResource ToolbarButtonStyle}">
                                                                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                                                <TextBlock x:Name="ButtonDeleteQueryImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE74D;" />
                                                                                <AccessText x:Name="ButtonDeleteQueryText" Text="Delete" Style="{StaticResource ToolbarTextStyle}" Visibility="Collapsed" />
                                                                        </StackPanel>
                                                                </Button>
                                                        </StackPanel>
                                                        <Border Style="{StaticResource ToolbarSeparatorStyle}" />
                                                        <!-- Queries: the queries on the tenant -->
                                                        <StackPanel Orientation="Horizontal">
                                                                <Button x:Name="ButtonRefreshQueries" TabIndex="18" IsEnabled="True" ToolTip="Refresh the query list" Style="{StaticResource ToolbarButtonStyle}">
                                                                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                                                <TextBlock x:Name="ButtonRefreshQueriesImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE72C;" />
                                                                                <AccessText x:Name="ButtonRefreshQueriesText" Text="Refresh" Style="{StaticResource ToolbarTextStyle}" Visibility="Collapsed" />
                                                                        </StackPanel>
                                                                </Button>
                                                                <Button x:Name="ButtonOpenQueryManager" TabIndex="19" ToolTip="Query manager: every query on the tenant, with details, history, create, rename and delete" Style="{StaticResource ToolbarButtonStyle}">
                                                                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                                                <TextBlock x:Name="ButtonOpenQueryManagerImage" Style="{StaticResource ToolbarGlyphStyle}" Text="&#xE71D;" />
                                                                                <AccessText x:Name="ButtonOpenQueryManagerText" Text="Queries" Style="{StaticResource ToolbarTextStyle}" Visibility="Collapsed" />
                                                                        </StackPanel>
                                                                </Button>
