<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-x:Namespace:Fortigi" Title="Fortigi Omada Sql Troubleshooter" Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" x:Name="MainForm" BorderBrush="#FFC8C8C8" SizeToContent="Manual">

        <Window.Style>
                <Style TargetType="Window">
                        <Setter Property="MinWidth" Value="1461" />
                        <Setter Property="Width" Value="1461" />
                        <Setter Property="MinHeight" Value="800" />
                        <Setter Property="Height" Value="800" />
                </Style>
        </Window.Style>

        <Grid x:Name="MainWindowGrid">
                <TabControl x:Name="TabControlSessions" BorderThickness="0" Padding="0">
                        <TabItem x:Name="TabItemAddNew" Header="+" ToolTip="Open a new tab" />
                </TabControl>
        </Grid>
</Window>
