<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help"
        Width="760"
        Height="560"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}"
        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
        Name="HelpForm">

    <!-- Help > Help and keyboard shortcuts (Open-HelpForm). Built from ui\Theme.xaml only
         (docs/UI-THEME.md). The shortcut list is Get-KeyboardShortcut, the list the keys are handled
         from, so it shows what the keys actually do. -->
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource Theme.DialogButtonStyle}"/>
        <Style TargetType="DataGrid" BasedOn="{StaticResource Theme.DataGridStyle}"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Omada Sql Troubleshooter" FontFamily="{StaticResource Theme.UiFont}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="TextBlockHelpVersion" Margin="12,0,0,0" FontFamily="{StaticResource Theme.UiFont}" Foreground="{StaticResource Theme.MutedTextBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="TabControlHelp">
            <TabItem Header="Keyboard shortcuts">
                <DataGrid x:Name="DataGridShortcuts" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Shortcut" Binding="{Binding Gesture}" Width="Auto" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Command" Binding="{Binding Description}" Width="Auto"/>
                        <DataGridTextColumn Header="Menu" Binding="{Binding Menu}" Width="Auto"/>
                        <DataGridTextColumn Header="Where" Binding="{Binding Where}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Links and feedback">
                <StackPanel Margin="12" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                    <TextBlock Text="Project" FontWeight="SemiBold" Margin="0,0,0,6" FontFamily="{StaticResource Theme.UiFont}"/>
                    <WrapPanel Margin="0,0,0,14">
                        <Button x:Name="ButtonHelpProject" ToolTip="The project on GitHub: source, documentation and releases">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <TextBlock Style="{StaticResource Theme.GlyphStyle}" Text="&#xE71B;"/>
                                <AccessText Style="{StaticResource Theme.ButtonTextStyle}" Text="_GitHub project"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ButtonHelpGallery" ToolTip="The module on the PowerShell Gallery: versions and install command">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <TextBlock Style="{StaticResource Theme.GlyphStyle}" Text="&#xE896;"/>
                                <AccessText Style="{StaticResource Theme.ButtonTextStyle}" Text="_PowerShell Gallery"/>
                            </StackPanel>
                        </Button>
                        <!-- Shown by Open-HelpForm only when GitHub has a release of the running version. -->
                        <Button x:Name="ButtonHelpRelease" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <TextBlock Style="{StaticResource Theme.GlyphStyle}" Text="&#xE7C3;"/>
                                <AccessText Style="{StaticResource Theme.ButtonTextStyle}" Text="_Release notes of this version"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ButtonHelpIssues" ToolTip="Open and closed issues on GitHub">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <TextBlock Style="{StaticResource Theme.GlyphStyle}" Text="&#xE8FD;"/>
                                <AccessText Style="{StaticResource Theme.ButtonTextStyle}" Text="_Issues"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="Feedback" FontWeight="SemiBold" Margin="0,0,0,6" FontFamily="{StaticResource Theme.UiFont}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontFamily="{StaticResource Theme.UiFont}" Foreground="{StaticResource Theme.MutedTextBrush}"
                               Text="Opens the issue form on GitHub in your browser (a GitHub account is needed). A bug report has the module, OmadaWeb.PS, PowerShell and Windows versions filled in; nothing is sent until you submit it, and no tenant, user or query data is included."/>
                    <WrapPanel>
                        <Button x:Name="ButtonHelpReportBug" ToolTip="Report a bug on GitHub">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <TextBlock Style="{StaticResource Theme.GlyphStyle}" Text="&#xEBE8;"/>
                                <AccessText Style="{StaticResource Theme.ButtonTextStyle}" Text="Report a _bug..."/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ButtonHelpRequestFeature" ToolTip="Request a feature on GitHub">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <TextBlock Style="{StaticResource Theme.GlyphStyle}" Text="&#xE82F;"/>
                                <AccessText Style="{StaticResource Theme.ButtonTextStyle}" Text="Request a _feature..."/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="ButtonCloseHelp" DockPanel.Dock="Right" Margin="0" IsCancel="True" IsDefault="True" ToolTip="Close">
                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource Theme.GlyphStyle}" Text="&#xE711;"/>
                    <AccessText Style="{StaticResource Theme.ButtonTextStyle}" Text="_Close"/>
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
