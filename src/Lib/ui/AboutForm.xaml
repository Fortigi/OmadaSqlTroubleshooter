<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="340"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        Name="AboutForm">

    <!-- Help > About: the startup splash screen (SplashScreenForm.xaml) - logo, name, version and
         copyright - in a window that stays until it is closed. -->
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <Image x:Name="AboutLogoImage"
               Width="150"
               Height="150"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Label x:Name="AboutTitleLabel"
               Content="Omada Sql Troubleshooter"
               FontSize="12"
               FontWeight="Bold"
               Margin="0,10,0,0"/>
        <Label x:Name="AboutVersionLabel"
               Content="Version"
               FontSize="10"/>
        <Button x:Name="ButtonCloseAbout"
                Content="_OK"
                Width="98"
                Height="25"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                IsDefault="True"
                IsCancel="True"/>
    </StackPanel>
</Window>
