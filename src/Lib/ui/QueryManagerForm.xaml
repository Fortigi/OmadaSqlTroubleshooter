<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Queries"
        Width="900"
        Height="600"
        MinWidth="600"
        MinHeight="350"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Name="QueryManagerForm">

    <!-- Every query object (C_P_SQLTROUBLESHOOTING) on the tenant. The grid's columns are generated
         from whatever fields OData returns (Get-QueryManagerColumn). Double-click opens the details. -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="ButtonRefreshQueryList" DockPanel.Dock="Right" Margin="8,0,0,0" ToolTip="Read the query list from the tenant again">_Refresh</Button>
            <TextBlock Text="Filter:" Margin="0,0,8,0"/>
            <TextBox x:Name="TextBoxQueryFilter" Height="26" VerticalContentAlignment="Center" FontFamily="Segoe UI"
                     ToolTip="Shows the queries where any column contains this text. * and ? are wildcards."/>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  x:Name="DataGridQueries"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  FontFamily="Segoe UI"/>

        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="ButtonCreateQueryObject" ToolTip="Create a new, empty query on the tenant (asks for a name)">_New...</Button>
            <Button x:Name="ButtonOpenQueryObject" ToolTip="Open the selected query in a tab">_Open in tab</Button>
            <Button x:Name="ButtonShowQueryObjectDetails" ToolTip="All fields, the SQL and the history of the selected query (or double-click it)">_Details...</Button>
            <Button x:Name="ButtonRenameQueryObject" ToolTip="Rename the selected query">Ren_ame...</Button>
            <Button x:Name="ButtonDeleteQueryObject" ToolTip="Delete the selected query from the tenant">De_lete...</Button>
            <Button x:Name="ButtonCloseQueryManager" DockPanel.Dock="Right" Margin="0" IsCancel="True">_Close</Button>
            <TextBlock x:Name="TextBlockQueryCount" DockPanel.Dock="Right" Margin="0,0,12,0" Foreground="Gray"/>
        </DockPanel>
    </Grid>
</Window>
