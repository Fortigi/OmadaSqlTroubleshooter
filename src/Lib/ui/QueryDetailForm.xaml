<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Query details"
        Width="820"
        Height="560"
        MinWidth="560"
        MinHeight="350"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Name="QueryDetailForm">

    <!-- One query object: every field OData returns plus created / last changed from its history,
         its SQL (read-only; it is edited in a tab), and its change history. -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TextBlockQueryTitle" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>

        <TabControl Grid.Row="1" x:Name="TabControlQueryDetail">
            <TabItem Header="Properties">
                <DataGrid x:Name="DataGridQueryProperties" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" CanUserAddRows="False" FontFamily="Segoe UI">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="Auto"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="SQL">
                <TextBox x:Name="TextBoxQueryText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>
            </TabItem>
            <TabItem Header="History">
                <DataGrid x:Name="DataGridQueryHistory" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" CanUserAddRows="False" FontFamily="Segoe UI">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding When, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="Auto"/>
                        <DataGridTextColumn Header="Who" Binding="{Binding Who}" Width="Auto"/>
                        <DataGridTextColumn Header="What" Binding="{Binding What}" Width="Auto"/>
                        <DataGridTextColumn Header="Changed fields" Binding="{Binding Fields}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="ButtonRenameQueryDetail" ToolTip="Rename this query">Ren_ame...</Button>
            <Button x:Name="ButtonOpenQueryDetail" ToolTip="Open this query in a tab">_Open in tab</Button>
            <Button x:Name="ButtonShowQueryDetailHistory" ToolTip="The history window for this query: compare versions, restore one, export">_Compare / restore...</Button>
            <Button x:Name="ButtonCloseQueryDetail" DockPanel.Dock="Right" Margin="0" IsCancel="True">_Close</Button>
        </DockPanel>
    </Grid>
</Window>
