<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Query details"
        Width="860"
        Height="580"
        MinWidth="640"
        MinHeight="350"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}"
        Name="QueryDetailForm">

    <!-- One query object: every field OData returns plus created / last changed from its history,
         its SQL (read-only; it is edited in a tab), and its change history. -->
    <Window.Resources>
        <!-- Same look as the main window's toolbar (MainFormTabContent.xaml, ToolbarButtonStyle):
             flat glyph buttons on the window's grey background. -->
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FFB0B7C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FlatButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FlatButtonBorder" Property="Background" Value="#FFD5E7F7"/>
                                <Setter TargetName="FlatButtonBorder" Property="BorderBrush" Value="#FF7EB4EA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FlatButtonBorder" Property="Background" Value="#FFC4DDF4"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FlatButtonBorder" Property="BorderBrush" Value="#FF3399FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
        </Style>
        <Style x:Key="ButtonTextStyle" TargetType="AccessText">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF5F7FA"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE1E4E8"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF293955" BorderThickness="0,4,0,0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TextBlockQueryTitle" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>

        <TabControl Grid.Row="1" x:Name="TabControlQueryDetail">
            <TabItem Header="Properties">
                <!-- Auto-sized columns and a horizontal scrollbar: a long value scrolls rather than
                     being cut off at the window edge. -->
                <DataGrid x:Name="DataGridQueryProperties" AutoGenerateColumns="False"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="Auto"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="Auto" MinWidth="300"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="SQL">
                <TextBox x:Name="TextBoxQueryText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>
            </TabItem>
            <TabItem Header="History">
                <!-- Every column sizes to its content (no star column, which would pin the grid to the
                     window's width) so a wide change scrolls horizontally instead of being cut off. -->
                <DataGrid x:Name="DataGridQueryHistory" AutoGenerateColumns="False"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding When, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="Auto"/>
                        <DataGridTextColumn Header="Who" Binding="{Binding Who}" Width="Auto"/>
                        <DataGridTextColumn Header="What" Binding="{Binding What}" Width="Auto"/>
                        <DataGridTextColumn Header="Changed fields" Binding="{Binding Fields}" Width="Auto" MinWidth="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="ButtonRenameQueryDetail" ToolTip="Rename this query">
                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE8AC;"/>
                    <AccessText Style="{StaticResource ButtonTextStyle}" Text="Ren_ame..."/>
                </StackPanel>
            </Button>
            <Button x:Name="ButtonOpenQueryDetail" ToolTip="Open this query in a tab">
                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE8A7;"/>
                    <AccessText Style="{StaticResource ButtonTextStyle}" Text="_Open in tab"/>
                </StackPanel>
            </Button>
            <Button x:Name="ButtonShowQueryDetailHistory" ToolTip="The history window for this query: compare versions, restore one, export">
                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE81C;"/>
                    <AccessText Style="{StaticResource ButtonTextStyle}" Text="_Compare / restore..."/>
                </StackPanel>
            </Button>
            <Button x:Name="ButtonOpenQueryDetailInOmada" ToolTip="Open this query's page in Omada, in your browser">
                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE774;"/>
                    <AccessText Style="{StaticResource ButtonTextStyle}" Text="Open in O_mada"/>
                </StackPanel>
            </Button>
            <Button x:Name="ButtonCloseQueryDetail" ToolTip="Close" DockPanel.Dock="Right" Margin="0" IsCancel="True">
                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE711;"/>
                    <AccessText Style="{StaticResource ButtonTextStyle}" Text="C_lose"/>
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
    </Border>
</Window>
